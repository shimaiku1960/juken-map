{
  "name": "juken-map",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm run db:start && pnpm run db:migrate && pnpm run \"/^dev:(web|go|proxy)$/\"",
    "dev:web": "pnpm --filter @juken-map/web dev",
    "dev:go": "bash scripts/dev-go.sh",
    "dev:proxy": "bash scripts/local-proxy.sh",
    "lint": "eslint",
    "lint:sql": "eslint --no-config-lookup -c eslint.sql.config.mjs \"db/**/*.ts\"",
    "test": "vitest run",
    "check": "pnpm exec eslint --max-warnings 0 && pnpm exec tsc --noEmit && pnpm -r typecheck && pnpm test && pnpm -r test && pnpm --filter @juken-map/web build",
    "e2e": "playwright test",
    "test:go-db": "pnpm --filter @juken-map/db test-db:prepare && cd apps/api && go test -tags dbtest -run 'TestA3|TestA4|TestLineStore|TestAdminUsersDB|TestAdminMastersDB|TestAuthDB|TestE2|TestIncidentCommandDB|TestGrantAdminCommandDB|TestMigrateDB|TestExpiredCleanupDB' -count=1 ./...",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "bash scripts/go-cli.sh migrate",
    "admin:grant": "bash scripts/go-cli.sh grant-admin",
    "incident": "bash scripts/go-cli.sh incident",
    "db:shell": "bash scripts/db-shell.sh",
    "obs:start": "docker compose up -d prometheus grafana loki alloy tempo mailpit",
    "obs:stop": "docker compose stop prometheus grafana loki alloy tempo mailpit",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "db:seed:synthetic": "tsx --env-file=.env db/seed-synthetic.ts",
    "db:seed:synthetic:clear": "CLEAR=on tsx --env-file=.env db/seed-synthetic.ts",
    "sim:run": "tsx --env-file-if-exists=.env sim/run-hour.ts",
    "sim:plan": "tsx --env-file-if-exists=.env sim/plan.ts",
    "capture:seed": "tsx --env-file=.env db/seed-capture.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "wt:new": "bash scripts/worktree-new.sh",
    "wt:remove": "bash scripts/worktree-remove.sh",
    "openapi:generate": "bash scripts/openapi-generate.sh",
    "lock:check": "bash scripts/check-lockfile.sh",
    "lock:linux": "bash scripts/check-lockfile.sh --linux",
    "lock:fix": "pnpm install --lockfile-only && pnpm run lock:linux"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "eslint": "^9",
    "globals": "^17.12.0",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
