{
  "name": "juken-map",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm run dev:infra && pnpm run db:migrate && pnpm run \"/^dev:(api|web)$/\"",
    "dev:infra": "docker compose up -d --wait db",
    "dev:api": "pnpm --filter @juken-map/api dev",
    "dev:web": "pnpm --filter @juken-map/web dev",
    "dev:infra:stop": "docker compose stop db",
    "dev:infra:logs": "docker compose logs -f db",
    "lint": "eslint",
    "test": "vitest run",
    "check": "pnpm exec eslint --max-warnings 0 && pnpm exec tsc --noEmit && pnpm -r typecheck && pnpm test && pnpm -r test && pnpm --filter @juken-map/web build",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter @juken-map/api migrate",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "capture:seed": "tsx --env-file=.env db/seed-capture.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "lock:check": "bash scripts/check-lockfile.sh",
    "lock:linux": "bash scripts/check-lockfile.sh --linux",
    "lock:fix": "pnpm install --lockfile-only && pnpm run lock:linux"
  },
  "dependencies": {
    "better-auth": "^1.6.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "eslint": "^9",
    "globals": "^17.12.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9"
  }
}
