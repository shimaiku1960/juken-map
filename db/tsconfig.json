{
  // db/ は seed・テスト用 DB の準備・DB の接続を持つ、開発でしか使わないパッケージ（JUK-130）。
  // 本番で動くものは Go（apps/api）にあり、ここのコードは本番に載らない。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    // TypeScript 6 からは @types を自動で読まない。
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "*.mts"],
  "exclude": ["node_modules"]
}
