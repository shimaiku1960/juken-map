#!/usr/bin/env bash

set -euo pipefail

readonly ZERO_OID="0000000000000000000000000000000000000000"
needs_lock_check=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
  if [[ "$local_oid" == "$ZERO_OID" ]]; then
    continue
  fi

  if [[ "$remote_oid" == "$ZERO_OID" ]]; then
    base_oid="$(git merge-base "$local_oid" origin/main 2>/dev/null || true)"
    if [[ -z "$base_oid" ]]; then
      needs_lock_check=1
      break
    fi
  else
    base_oid="$remote_oid"
  fi

  if ! git diff --quiet "$base_oid" "$local_oid" -- package.json package-lock.json; then
    needs_lock_check=1
    break
  fi
done

if [[ "$needs_lock_check" -eq 0 ]]; then
  exit 0
fi

if ! git diff --quiet -- package.json package-lock.json \
  || ! git diff --cached --quiet -- package.json package-lock.json; then
  echo "エラー: 依存ファイルに未コミットの変更があります。コミットしてから再度pushしてください。" >&2
  exit 1
fi

echo "依存ファイルの変更を検出したため、Linux lockfileを確認します。"
npm run lock:check
