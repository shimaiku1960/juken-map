// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique

  image    String?
  nickname String?

  accounts      Account[]
  sessions      Session[]
  finalGoals    FinalGoal[]
  studyPlans    StudyPlan[]
  studyLogs     StudyLog[]
  textbooks     Textbook[]
  supportCheckoutInvitations SupportCheckoutInvitation[]
  supportSubscription SupportSubscription?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  emailVerified Boolean     @default(false)

  @@map("user")
}

model SupportCheckoutInvitation {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  guardianConsentConfirmedAt DateTime?
  checkoutSessionId String? @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email(length: 191)])
  @@index([userId(length: 191)])
}

model SupportSubscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String   @unique
  status               String
  trialUsed            Boolean  @default(false)
  trialEndsAt          DateTime?
  currentPeriodEndsAt  DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  canceledAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status(length: 191)])
}

model Account {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId    String  @db.Text
  providerId   String  @db.Text
  accessToken  String? @db.Text
  refreshToken String? @db.Text
  idToken      String? @db.Text
  scope        String? @db.Text

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Session {
  id     String @id @default(cuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model FinalGoal {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId Int
  faculty   Faculty  @relation(fields: [facultyId], references: [id])

  isFirstChoice Boolean @default(false)
  note          String? @db.Text

  // "candidate"（気になる＝比較検討中）/ "decided"（受験校として確定）。
  // 既存行は decided 相当のためデフォルトを decided に。探す画面からは candidate で追加する。
  status String @default("decided")

  @@unique([userId, facultyId])
}

model University {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  prefecture String   @default("")
  type       String   @default("")
  createdAt  DateTime @default(now())

  faculties Faculty[]
}

model Faculty {
  id           Int        @id @default(autoincrement())
  name         String
  examDate     DateTime
  createdAt    DateTime   @default(now())
  universityId Int
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  finalGoals FinalGoal[]
  tags       Tag[]
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  faculties Faculty[]
}

model StudyPlan {
  id      Int      @id @default(autoincrement())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime
  content String?  @db.Text
  subject String?
  done    Boolean  @default(false)

  textbookId Int?
  textbook   Textbook? @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  rangeStart Int?
  rangeEnd   Int?
  rangeUnit  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  studyLog StudyLog?

  @@index([userId(length: 191)])
  @@index([textbookId])
}

model Textbook {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterId    Int?
  master      TextbookMaster? @relation(fields: [masterId], references: [id], onDelete: SetNull)
  name        String
  totalAmount Int?
  rangeUnit   String?
  targetDate  DateTime?
  // 対策科目（english/math/... SUBJECT_VALUES）。未設定は null。
  // 志望校（受験日）→科目→参考書→今日のノルマ、という計画〜実行の因果を繋ぐ。
  subject     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studyPlans StudyPlan[]
  studyLogs  StudyLog[]

  @@unique([userId, name])
  @@index([userId(length: 191)])
  @@index([masterId])
}

model TextbookMaster {
  id        Int      @id @default(autoincrement())
  name      String
  publisher String?
  edition   String?
  isbn      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics   TextbookMasterMetric[]
  textbooks Textbook[]
}

model TextbookMasterMetric {
  id          Int      @id @default(autoincrement())
  masterId    Int
  master      TextbookMaster @relation(fields: [masterId], references: [id], onDelete: Cascade)
  unit        String
  totalAmount Int
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([masterId, unit])
  @@index([masterId])
}

model StudyLog {
  id      Int      @id @default(autoincrement())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime
  subject String?
  minutes Int

  textbookId Int?
  textbook   Textbook? @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  rangeStart Int?
  rangeEnd   Int?
  rangeUnit  String?
  memo       String?   @db.Text

  studyPlanId Int?       @unique
  studyPlan   StudyPlan? @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId(length: 191)])
  @@index([textbookId])
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}
