# Local MySQL started by Docker Compose
DATABASE_URL="mysql://juken:jukenpassword@localhost:3306/juken_map"

# Login (apps/api auth_*.go). The name is left over from Better Auth.
# The key that encrypts TOTP secrets is derived from it unless AUTH_TOTP_KEYS is set.
# Generate a sufficiently long random value for local development.
BETTER_AUTH_SECRET="replace-with-a-random-secret"
# Optional. "version:base64-of-32-bytes", comma separated, newest first.
# AUTH_TOTP_KEYS="v1:replace-with-base64-32-bytes"

# Google OAuth
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# GitHub OAuth
AUTH_GITHUB_ID="replace-with-github-client-id"
AUTH_GITHUB_SECRET="replace-with-github-client-secret"

# Resend
RESEND_API_KEY="replace-with-resend-api-key"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
# Protects the scheduled notification endpoint. Use a long random value.
DAILY_NOTIFICATION_SECRET="replace-with-a-random-secret"

# Simulation (sim/). Leave SIMULATION_ENABLED unset to keep /api/sim/* off (404).
# SIMULATION_ENABLED="on"
# SIMULATION_SECRET="replace-with-a-random-secret"

# Fault injection (apps/api/internal/fault). Leave CHAOS_ENABLED unset to inject nothing and keep /api/chaos/* off (404).
# CHAOS_ENABLED="on"
# Random weekday experiments with no advance notice, emailed to ADMIN_NOTIFICATION_EMAIL afterwards. Needs CHAOS_ENABLED.
# CHAOS_SCHEDULE="on"
# Also draw host faults (CPU, memory, disk, network to RDS, process kill) run on EC2 via SSM Run Command. Production only.
# CHAOS_HOST="on"
# CHAOS_SECRET="replace-with-a-random-secret"
# Full-access Resend key, used only by the simulator to read sent verification emails
# RESEND_READ_API_KEY="replace-with-resend-full-access-key"

# LINE Messaging API (server-only)
LINE_CHANNEL_SECRET="replace-with-line-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="replace-with-line-channel-access-token"
# LINE Login channel under the same Provider (server-only)
LINE_LOGIN_CHANNEL_ID="replace-with-line-login-channel-id"
LINE_LOGIN_CHANNEL_SECRET="replace-with-line-login-channel-secret"

# microCMS
MICROCMS_API_KEY="replace-with-microcms-api-key"
MICROCMS_SERVICE_DOMAIN="replace-with-service-domain"

# Google Analytics 4 (omit to disable analytics)
GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Grafana Faro collector URL for browser errors (optional; omit to disable). Production reads it from Secrets Manager
# FARO_COLLECTOR_URL="https://faro-collector-prod-xx.grafana.net/collect/xxxxxxxx"

# Server log level (optional; default "info"). e.g. "debug" to also log incoming requests
# LOG_LEVEL="info"

# Prometheus metrics port (optional; /metrics is served only when set). Use with `pnpm run obs:start`
# METRICS_PORT="9464"

# Development only: also write JSON logs to this file (relative to the repo root) for Loki via Alloy
# LOG_FILE="logs/api.log"

# Development only: send OpenTelemetry traces to Tempo (enabled only when set)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
