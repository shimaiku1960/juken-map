# Local MySQL started by Docker Compose
DATABASE_URL="mysql://juken:jukenpassword@localhost:3306/juken_map"

# Better Auth
# Generate a sufficiently long random value for local development.
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# GitHub OAuth
AUTH_GITHUB_ID="replace-with-github-client-id"
AUTH_GITHUB_SECRET="replace-with-github-client-secret"

# Resend
RESEND_API_KEY="replace-with-resend-api-key"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
# Protects the scheduled notification endpoint. Use a long random value.
DAILY_NOTIFICATION_SECRET="replace-with-a-random-secret"

# LINE Messaging API (server-only)
LINE_CHANNEL_SECRET="replace-with-line-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="replace-with-line-channel-access-token"
# LINE Login channel under the same Provider (server-only)
LINE_LOGIN_CHANNEL_ID="replace-with-line-login-channel-id"
LINE_LOGIN_CHANNEL_SECRET="replace-with-line-login-channel-secret"

# microCMS
MICROCMS_API_KEY="replace-with-microcms-api-key"
MICROCMS_SERVICE_DOMAIN="replace-with-service-domain"
