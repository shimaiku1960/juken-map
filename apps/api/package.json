{
  "name": "@juken-map/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --env-file-if-exists=../../.env.worktree --import ./src/instrumentation.ts src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "admin:grant": "tsx --env-file-if-exists=../../.env src/grant-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/otel": "^0.21.0",
    "@fastify/static": "^10.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-mysql2": "^0.68.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-auth": "^1.6.22",
    "fastify": "^5.12.3",
    "import-in-the-middle": "^3.5.1",
    "microcms-js-sdk": "^3.5.0",
    "mysql2": "^3.24.4",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "resend": "^6.27.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
