{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/api/*": ["./src/*"],
      "@/shared/*": ["../../src/shared/*"],
      "@/*": ["../../*"]
    }
  },
  "include": ["src/**/*.ts", "../../src/shared/**/*.ts"],
  "exclude": ["node_modules", "src/generated"]
}
