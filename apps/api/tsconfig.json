{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/frontend/*": ["../../src/frontend/*"],
      "@/backend/*": ["../../src/backend/*"],
      "@/shared/*": ["../../src/shared/*"],
      "@/*": ["../../*"]
    }
  },
  "include": ["src/**/*.ts", "../../src/backend/**/*.ts", "../../src/shared/**/*.ts"],
  "exclude": ["node_modules"]
}
